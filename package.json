{
  "name": "familyguardian-ai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "db:up": "docker compose -f infrastructure/docker-compose.yml up -d db",
    "db:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:migrate": "pnpm --filter @fg/api db:migrate",
    "db:seed": "pnpm --filter @fg/api db:seed",
    "dev:api": "pnpm --filter @fg/api dev",
    "dev:web": "pnpm --filter @fg/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
