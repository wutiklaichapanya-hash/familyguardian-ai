# syntax=docker/dockerfile:1
# FamilyGuardian AI — API image (services/api, Fastify).
# Local / evaluation use only. Not a production image: no deploy is automated (RELEASE gate).
# Build from the repo root:
#   docker compose -f infrastructure/docker-compose.yml --profile full build api
ARG NODE_IMAGE=node:22-bookworm-slim
ARG PNPM_VERSION=12.16.1

# ---- base: node + pnpm via corepack -------------------------------------------------
FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

# ---- deps: fetch the store from the lockfile only (cache-friendly) -----------------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=cache,id=fg-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && pnpm fetch

# ---- build: install the workspace offline from the fetched store -------------------
FROM deps AS build
COPY . .
RUN --mount=type=cache,id=fg-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --offline
# The API runs TypeScript through tsx (no compile step), so there is nothing to build.
# Typecheck is a CI job, not an image step, so the image builds while other modules are WIP.

# ---- runtime ------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production \
    API_PORT=4100 \
    HOST=0.0.0.0
WORKDIR /app
COPY --from=build /app /app
# Files stay root-owned and read-only for the app user; the API writes nothing to disk.
USER node
WORKDIR /app/services/api
EXPOSE 4100
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.API_PORT||4100)+'/api/health').then(r=>r.json()).then(b=>process.exit(b.status==='ok'?0:1)).catch(()=>process.exit(1))"]
# Env comes from compose (env_file ../.env + overrides). We do not use the package's
# `start` script because it passes --env-file=../../.env, which does not exist in the image.
CMD ["node", "--import", "tsx", "src/server.ts"]
