# syntax=docker/dockerfile:1
# FamilyGuardian AI — web image (apps/web, Next.js PWA).
# Local / evaluation use only. Not a production image: no deploy is automated (RELEASE gate).
# Build from the repo root:
#   docker compose -f infrastructure/docker-compose.yml --profile full build web
ARG NODE_IMAGE=node:22-bookworm-slim
ARG PNPM_VERSION=12.16.1

# ---- base: node + pnpm via corepack -------------------------------------------------
FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1 \
    CI=true
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

# ---- deps: fetch the store from the lockfile only (cache-friendly) -----------------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=cache,id=fg-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && pnpm fetch

# ---- build: install offline, then `next build` --------------------------------------
FROM deps AS build
# next.config.ts reads API_BASE_URL for its /api/v1 rewrite. Rewrites are resolved at
# build time, so the in-network API address must be known here.
ARG API_BASE_URL=http://api:4100
ENV API_BASE_URL=${API_BASE_URL}
COPY . .
RUN --mount=type=cache,id=fg-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --offline
# NODE_ENV is set only for the build step so the install above keeps devDependencies.
RUN NODE_ENV=production pnpm --filter @fg/web build

# ---- runtime ------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
ARG API_BASE_URL=http://api:4100
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    API_BASE_URL=${API_BASE_URL} \
    PORT=3100 \
    HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build /app /app
# Next writes its image/fetch cache under .next/cache at runtime; only that is writable.
RUN mkdir -p /app/apps/web/.next/cache && chown -R node:node /app/apps/web/.next/cache
USER node
WORKDIR /app/apps/web
EXPOSE 3100
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3100/',{redirect:'manual'}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3100", "-H", "0.0.0.0"]
