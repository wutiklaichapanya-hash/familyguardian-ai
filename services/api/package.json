{
  "name": "@fg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "purge:run": "tsx --env-file-if-exists=../../.env src/retention.ts",
    "audit:verify": "tsx --env-file-if-exists=../../.env src/auditChain.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@fg/ai": "workspace:*",
    "@fg/payments": "workspace:*",
    "@fg/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "pg-boss": "^12.0.0",
    "postgres": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0"
  }
}
